# Copy this file to .env and fill in real values. Never commit .env.

# Flask session signing key — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=037f343d7f7f42f013560a4f273a1f419a206895893d5ee057ddbe26808d9c42
SESSION_COOKIE_SECURE=0

# Password for the first-run "admin" account (only used the very first time
# the database is created). Set this before the first launch.
ADMIN_PASSWORD=

# --- Campay (https://www.campay.net) ---------------------------------------
# From your Campay dashboard > App Keys. Leave these empty to keep deposits/
# withdrawals on the manual (admin-approved) flow.
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
# Optional: a permanent app token from the same dashboard page skips the
# username/password token exchange entirely. If set, it takes priority.
CAMPAY_PERMANENT_TOKEN=
# Webhook signing key (dashboard > App Keys > Webhook key). Required to
# verify that a "payment successful" callback really came from Campay and
# wasn't forged — set this before relying on the webhook to credit balances.
CAMPAY_WEBHOOK_KEY=
# Sandbox: https://demo.campay.net   Production: https://www.campay.net
CAMPAY_BASE_URL=https://demo.campay.net

# --- Maviance / Smobilpay (https://maviance.com/solutions/smobilpay/) ------
# Provided during Maviance's merchant onboarding.
MAVIANCE_API_KEY=
MAVIANCE_API_SECRET=
MAVIANCE_PAYMENT_ITEM=
MAVIANCE_BASE_URL=https://s3p.smobilpay.com
